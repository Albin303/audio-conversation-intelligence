HUGGINGFACE_TOKEN=
DIARIZATION_BACKEND=free-local
PYANNOTE_PIPELINE=pyannote/speaker-diarization-3.1
LLAMA_API_KEY=
LLAMA_MODEL=llama-3.3-70b-versatile
LLAMA_API_URL=https://api.groq.com/openai/v1/chat/completions
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Speaker Diarization LLM configuration
USE_LLM_DIARIZATION=true
DIARIZATION_LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Real-Time Speaker Tracking & Classification settings
ROLE_BACKEND=hybrid
ENABLE_STREAMING=true
ENABLE_VAD=true
ENABLE_SPEAKER_TRACKING=false
ROLE_CONFIDENCE_THRESHOLD=0.85
WHISPER_MODEL=large-v3
SPEECHBRAIN_MODEL=speechbrain/spkrec-ecapa-voxceleb

# Nexus AI v2 runtime storage
NEXUS_ENV=development
NEXUS_STORAGE_BACKEND=sqlite
NEXUS_UPLOADS_DIR=uploads
NEXUS_DATABASE_DIR=database
NEXUS_LOGS_DIR=logs
NEXUS_SQLITE_PATH=database/nexus_ai.db
NEXUS_ENABLE_REQUEST_LOGGING=true

# SAP C4C Lead Integration Configuration
SAP_C4C_ENABLED=false
SAP_C4C_ENDPOINT=https://<SAP-ENDPOINT>/sap/c4c/api/v1/lead-service/leads
SAP_C4C_USERNAME=
SAP_C4C_PASSWORD=
SAP_C4C_TIMEOUT_SEC=10.0
SAP_C4C_LEAD_SOURCE=Z3
SAP_C4C_MARKET_SEGMENT=001
